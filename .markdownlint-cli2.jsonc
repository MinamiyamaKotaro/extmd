{
  // このリポジトリは日本語の技術文書（docs/design, docs/requirement, docs/security）が
  // 中心のため、文章量に起因する誤検知が多いルールのみ無効化する。
  "config": {
    "default": true,
    // 日本語の長文段落が大半のため行長制限は意味をなさない
    "MD013": false,
    // 各知見（脆弱性・戦略等）ごとに「詳細」「攻撃シナリオ」等の同名見出しを
    // 繰り返す構成を採用しているため、直接の兄弟見出し間のみ重複を禁止する
    "MD024": { "siblings_only": true },
    // 設計書中のコードコメント等でインラインHTMLタグを文字列として言及するため無効化
    "MD033": false,
    // 「**リスクレベル: Medium**」のような強調を意図的に見出し代わりに使っている箇所があるため無効化
    "MD036": false,
    // ディレクトリ構成・パイプライン図等、意図的に言語指定なしのASCII図を使うコードブロックがあるため無効化
    "MD040": false,
    // 表の記法は既存ドキュメント全体で "| a | b |" のスペースありスタイルに統一しているため
    // "compact" 前提のこのルールは無効化（既定の pipe-space 相当をMD055/MD058側で担保）
    "MD060": false
  }
}
